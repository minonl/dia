{
  "name": "@minonl/dia",
  "version": "0.0.15",
  "type": "module",
  "description": "dia (嗲) — lightweight agent framework: knowledge index, audit, session ingest",
  "bin": {
    "dia": "bin/dia.js"
  },
  "files": [
    "bin",
    "dist",
    "packages/wt",
    "packages/job",
    "docs",
    "kits",
    "README.md"
  ],
  "engines": {
    "node": ">=24",
    "bun": ">=1.2"
  },
  "scripts": {
    "dev": "bun packages/cli/src/index.ts",
    "build": "bun build packages/cli/src/index.ts --target node --outfile dist/cli.js --external bun:sqlite",
    "test": "bun test tests && bash tests/smoke.sh && bash tests/e2e.sh",
    "compile": "bun build packages/cli/src/index.ts --compile --outfile dist/dia",
    "prepublishOnly": "bun run build",
    "test:job": "pnpm --filter @dia/job test",
    "test:kb": "pnpm --filter @dia/kb test",
    "bench:kb": "bun experiments/kb-bench.ts",
    "golden:kb": "bun experiments/kb-golden.ts",
    "docs:index": "node scripts/docs-index.mjs",
    "docs:check": "node scripts/docs-index.mjs --check",
    "docs:links": "node scripts/docs-link-check.mjs"
  },
  "license": "MIT",
  "packageManager": "pnpm@12.5.1",
  "devDependencies": {
    "@dia/kb": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/minonl/dia.git"
  },
  "homepage": "https://github.com/minonl/dia"
}
